{
  "name": "manifestacao",
  "private": true,
  "version": "0.0.0",
  "description": "Jogo de manifestação online multiplayer no navegador (projeto próprio inspirado no Paulista Livre)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @manifestacao/client dev",
    "dev:server": "pnpm --filter @manifestacao/server dev",
    "dev:api": "pnpm --filter @manifestacao/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
