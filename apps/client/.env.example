# Cliente (Vite). Copie para .env.local e preencha. Só variáveis VITE_ vão
# para o navegador — NUNCA coloque segredos aqui (apenas a chave ANÔNIMA).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client ID do OAuth do Google (Google Cloud Console → Credenciais → ID do
# cliente OAuth 2.0, tipo "Aplicativo da Web"). Público, não é segredo — usado
# pelo botão de login via Google Identity Services (GIS).
VITE_GOOGLE_CLIENT_ID=

# Páginas legais (/sobre, /termos, /privacidade): quem opera o jogo e o e-mail de contato/DPO.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
