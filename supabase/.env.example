# Segredos das Edge Functions (Supabase → Edge Functions → Secrets).
# NÃO commitar valores reais. SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são
# injetados automaticamente no ambiente das functions; os demais você define.

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Resend (e-mail transacional)
RESEND_API_KEY=
RESEND_FROM=Manifestação <no-reply@seu-dominio.com>

# CORS: origem permitida (domínio da Vercel em produção)
# Em produção use o domínio da Vercel (não "*"):
ALLOWED_ORIGIN=https://SEU-DOMINIO.vercel.app
